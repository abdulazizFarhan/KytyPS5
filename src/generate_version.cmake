#message("${GIT_EXECUTABLE}")
if(GIT_EXECUTABLE)
	execute_process(COMMAND ${GIT_EXECUTABLE} describe --tags --always OUTPUT_VARIABLE KYTY_GIT_VERSION)
	execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD OUTPUT_VARIABLE KYTY_GIT_HASH)
	execute_process(COMMAND ${GIT_EXECUTABLE} diff --quiet OUTPUT_VARIABLE KYTY_GIT_DIRTY WORKING_DIRECTORY ${GIT_WORKING_DIRECTORY})
	execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain OUTPUT_VARIABLE KYTY_GIT_DIRTY_STATUS WORKING_DIRECTORY ${GIT_WORKING_DIRECTORY})
else()
	set(KYTY_GIT_VERSION "unknown")
	set(KYTY_GIT_HASH "unknown")
endif()
string(STRIP ${KYTY_GIT_VERSION} KYTY_GIT_VERSION)
string(STRIP ${KYTY_GIT_HASH} KYTY_GIT_HASH)
if(KYTY_GIT_DIRTY OR KYTY_GIT_DIRTY_STATUS)
	string(APPEND KYTY_GIT_HASH "-dirty")
endif()
configure_file(${INPUT_FILE} ${OUTPUT_FILE})
